---
/** Shown for any address that does not exist. Kept out of search results and the edge cache. */
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="Page not found" path={Astro.url.pathname} robots="noindex, follow">
	<div class="wrap" style="padding-block: var(--space-l)">
		<h1 class="h-page">Page not found</h1>
		<p class="lead muted" style="margin-block: var(--space-s)">
			That address does not exist. It may have moved, or the link may be mistyped.
		</p>
		<p><a class="arrow-link" href="/">Go to the homepage</a></p>
	</div>
</Base>
