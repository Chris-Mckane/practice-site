---
/**
 * Renders an image from the media library through EmDash's image component:
 * AVIF with a WebP fallback, responsive sizes, explicit width and height.
 *
 * Alt text is mandatory. EmDash has no "required alt" switch, so an image
 * without alt text is simply not shown (and the editor sees it is missing).
 */
import type { ImageValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	image: ImageValue | null | undefined;
	/** The widest the image is ever displayed, in CSS pixels. Files up to twice this are offered for sharp screens. */
	width: number;
	/** CSS `sizes` hint: how wide the image is displayed at different screen widths. */
	sizes: string;
	/** True only for an image that is the largest thing in the first screen. */
	priority?: boolean;
	class?: string;
}

const { image, width, sizes, priority = false, class: className } = Astro.props;
const hasAlt = Boolean(image?.alt?.trim());
// Keep the original aspect ratio so the browser can reserve the right space before the file arrives.
const height = image?.width && image.height ? Math.round((width * image.height) / image.width) : undefined;
---

{
	image && hasAlt && (
		<div class:list={["photo", className]}>
			<Image image={image} width={width} height={height} sizes={sizes} priority={priority} formats={["avif", "webp"]} />
		</div>
	)
}
