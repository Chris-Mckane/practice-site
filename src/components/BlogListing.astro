---
/**
 * The blog index: a paginated list of posts with category links.
 * Used by /blog, /blog/page/N, /blog/category/slug and /blog/category/slug/page/N.
 *
 * The heading, introduction and SEO fields of the main index come from the page
 * with the slug "blog" in the Pages collection, so they are editable in the admin.
 */
import "../styles/sections.css";
import { getEmDashCollection, getEmDashEntry, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../layouts/Base.astro";
import type { Block } from "../lib/blocks";
import { breadcrumbNode, websiteId, type Crumb } from "../lib/jsonld";
import { entrySeo } from "../lib/seo";
import { absoluteUrl, getSite } from "../lib/site";
import Breadcrumbs from "./Breadcrumbs.astro";
import PageSections from "./PageSections.astro";
import PostList from "./PostList.astro";

interface Props {
	/** Page number, starting at 1. */
	page: number;
	/** Category slug, when listing a single category. */
	category?: string;
}

const { page, category } = Astro.props;
const site = await getSite(Astro);

const [blogPage, terms] = await Promise.all([
	getEmDashEntry("pages", "blog"),
	getTaxonomyTermsWithCacheHint("category"),
]);
const term = category ? terms.data.find((item) => item.slug === category) : undefined;
if (!Number.isInteger(page) || page < 1 || (category && !term)) return Astro.rewrite("/404");

const { entries, hasMore, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	limit: site.postsPerPage,
	offset: (page - 1) * site.postsPerPage,
	orderBy: { published_at: "desc" },
	...(term ? { where: { category: term.slug } } : {}),
});
if (page > 1 && entries.length === 0) return Astro.rewrite("/404");

if (Astro.cache?.enabled) {
	for (const hint of [blogPage.cacheHint, terms.cacheHint, cacheHint]) Astro.cache.set(hint);
}

const base = term ? `/blog/category/${term.slug}` : "/blog";
const pathFor = (n: number) => (n === 1 ? base : `${base}/page/${n}`);
const path = pathFor(page);
const blogSeo = blogPage.entry ? entrySeo(site, blogPage.entry, "/blog") : null;
const blogTitle = blogSeo?.title ?? "Blog";
const heading = term ? term.label : blogTitle;
const title = page > 1 ? `${heading}, page ${page}` : heading;
const isIndex = !term && page === 1;
const blocks: Block[] = isIndex && Array.isArray(blogPage.entry?.data.layout) ? blogPage.entry.data.layout : [];

const crumbs: Crumb[] = [
	{ label: "Home", path: "/" },
	{ label: blogPage.entry?.data.title ?? "Blog", path: "/blog" },
	...(term ? [{ label: term.label, path: `/blog/category/${term.slug}` }] : []),
	...(page > 1 ? [{ label: `Page ${page}`, path }] : []),
];
const url = absoluteUrl(site, path);
const categories = terms.data.filter((item) => (item.count ?? 1) > 0);
---

<Base
	title={title}
	description={isIndex ? blogSeo?.description : null}
	path={path}
	image={isIndex ? blogSeo?.image : null}
	content={isIndex && blogPage.entry ? { collection: "pages", id: blogPage.entry.data.id, slug: "blog" } : undefined}
	jsonld={[
		{
			"@type": "CollectionPage",
			"@id": `${url}#webpage`,
			url,
			name: title,
			inLanguage: "en-GB",
			isPartOf: { "@id": websiteId(site) },
		},
		breadcrumbNode(site, crumbs),
	]}
>
	{
		blocks.length > 0 ? (
			<PageSections blocks={blocks} />
		) : (
			<header class="page-header wrap">
				{crumbs.length > 2 && <Breadcrumbs crumbs={crumbs} />}
				<h1 class="h-page">{title}</h1>
			</header>
		)
	}
	<section class="section">
		<div class="wrap section__grid">
			<div class="section__head">
				{
					categories.length > 0 && (
						<nav aria-label="Blog categories">
							<ul class="cats">
								<li>
									<a href="/blog" aria-current={!term ? "page" : undefined}>
										All posts
									</a>
								</li>
								{categories.map((item) => (
									<li>
										<a href={`/blog/category/${item.slug}`} aria-current={item.slug === term?.slug ? "page" : undefined}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
			</div>
			<div>
				{entries.length > 0 ? <PostList posts={entries} heading="h2" /> : <p class="muted">No posts yet.</p>}
				{
					(page > 1 || hasMore) && (
						<nav class="pagination meta" aria-label="Pagination">
							{page > 1 ? (
								<a class="arrow-link" href={pathFor(page - 1)} rel="prev">
									Newer posts
								</a>
							) : (
								<span />
							)}
							<span>Page {page}</span>
							{hasMore ? (
								<a class="arrow-link" href={pathFor(page + 1)} rel="next">
									Older posts
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}
			</div>
		</div>
	</section>
</Base>
