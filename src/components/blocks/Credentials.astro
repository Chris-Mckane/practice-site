---
/** Credentials: a simple table of qualification, issuer and year. */
import { rows, str, type BlockProps } from "../../lib/blocks";
import { paragraphs } from "../../lib/format";

type Props = BlockProps;

const { value } = Astro.props;
const heading = str(value.heading);
const items = rows(value.items).filter((item) => str(item.name));
---

<section class="section">
	<div class="wrap section__grid">
		<div class="section__head">
			<h2 class="h-section">{heading}</h2>
		</div>
		<div class="section__body">
			<div class="flow">{paragraphs(value.intro).map((text) => <p class="muted">{text}</p>)}</div>
			{
				items.length > 0 && (
					<table class="credentials">
						<caption class="sr-only">{heading}</caption>
						<thead>
							<tr class="meta">
								<th scope="col">Credential</th>
								<th scope="col">Issuer</th>
								<th scope="col">Year</th>
							</tr>
						</thead>
						<tbody>
							{items.map((item) => (
								<tr>
									<th scope="row">{str(item.name)}</th>
									<td class="muted">{str(item.issuer)}</td>
									<td class="muted">{str(item.year)}</td>
								</tr>
							))}
						</tbody>
					</table>
				)
			}
		</div>
	</div>
</section>
